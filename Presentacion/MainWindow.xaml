<Window x:Class="Presentacion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentacion"
        mc:Ignorable="d"
        Title="Gestión de Productos" Height="600" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Top">
            <StackPanel Width="420">
                <TextBlock Text="IdProducto" />
                <TextBox x:Name="txtId" IsReadOnly="True" />
                <TextBlock Text="Nombre" Margin="0,6,0,0" />
                <TextBox x:Name="txtNombre" />
                <TextBlock Text="Precio Unidad" Margin="0,6,0,0" />
                <TextBox x:Name="txtPrecio" />
                <TextBlock Text="Unidades En Existencia" Margin="0,6,0,0" />
                <TextBox x:Name="txtStock" />
            </StackPanel>

            <StackPanel Margin="20,0,0,0">
                <Button x:Name="btnNuevo" Content="Nuevo" Width="120" Margin="0,0,0,6" Click="BtnNuevo_Click" />
                <Button x:Name="btnGuardar" Content="Guardar" Width="120" Margin="0,0,0,6" Click="BtnGuardar_Click" />
                <Button x:Name="btnActualizar" Content="Actualizar" Width="120" Margin="0,0,0,6" Click="BtnActualizar_Click" />
                <Button x:Name="btnEliminar" Content="Eliminar" Width="120" Margin="0,0,0,6" Click="BtnEliminar_Click" />
            </StackPanel>

            <StackPanel Margin="20,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="Buscar por nombre" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="txtBuscar" Width="220" />
                    <Button x:Name="btnBuscar" Content="Buscar" Margin="6,0,0,0" Click="BtnBuscar_Click" />
                </StackPanel>
                <Button x:Name="btnLimpiar" Content="Limpiar" Width="120" Margin="0,6,0,0" Click="BtnLimpiar_Click" />
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="dgProductos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="DgProductos_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding IdProducto}" Width="60" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding NombreProducto}" Width="*" />
                <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad}" Width="100" />
                <DataGridTextColumn Header="Stock" Binding="{Binding UnidadesEnExistencia}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
